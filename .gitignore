# 설치물 (requirements.txt로 재생성)
.vendor/

# 모델 가중치 (scripts/download_model.py로 재다운로드)
models/
*.bin
*.safetensors
*.onnx

# 실행 중 생성되는 로그와 데이터
logs/
*.jsonl

# 파이썬 캐시
__pycache__/
*.pyc

# 검증·테스트 산출물
verification/
# 평가 세트(이미지·정답·캐시·결과). 라이선스 제한으로 저장소에 올리지 않는다.
eval/
# 로컬 개발용 심볼릭 링크 (../models)
models
# 배포 모니터링 산출물 (CD 실행 중 생성, 아티팩트로만 보관)
monitor/
tests/fixtures/*
!tests/fixtures/images/
tests/fixtures/images/*
!tests/fixtures/images/bibimbap_seoul_beef.jpg
!tests/fixtures/images/SOURCES.md
.pytest_cache/

# 인증정보·환경 설정 (절대 커밋하지 말 것)
.env
.env.*
*.pem
*.key
.hf_token

# Self-hosted runner: 설치 파일, 자격 증명, 작업 폴더 (저장소 안에 두더라도 커밋하지 않음)
actions-runner*/
_work/
_diag/
externals/
bin/Runner.*
.runner
.credentials
.credentials_rsaparams
.path
*.tar.gz
run-helper.sh
run-helper.cmd

# macOS 잡파일
.DS_Store
